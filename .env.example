# SentinelAI — environment configuration
# See docs/03_API/Configuration_and_Secrets.md for the full rationale.
# Never commit a real .env file — only this template.

# --- Mandatory (SentinelAI refuses to start without these) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
DATABASE_PATH=

# --- Optional (advisory-tier; absence degrades gracefully, never blocks startup) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

# One per configured security-intelligence feed, e.g. SECURITY_INTEL_NVD_API_KEY=
